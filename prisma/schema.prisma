// schema.prisma
generator client {
  provider = "prisma-client"
    output   = "./generated"
}

datasource db {
  provider = "postgresql"
}


model Tournament {
  id                   String             @id @default(cuid())
  name                 String
  venueId              String
  venue                Venue              @relation(fields: [venueId], references: [id])
  championId           String?
  champion             Player?            @relation("champion", fields: [championId], references: [id])
  date                 DateTime           @default(now())
  createdAt            DateTime           @default(now())
  finishedAt           DateTime?
  status               TournamentStatus   @default(PREPARATION)
  matches              Match[]
  surfaceId            String
  surface              Surface            @relation(fields: [surfaceId], references: [id])
  tournamentCategory   TournamentCategory @relation(fields: [tournamentCategoryId], references: [id])
  tournamentCategoryId String
  tournamentTypeId     String?
  tournamentType       TournamentType?   @relation(fields: [tournamentTypeId], references: [id])
  players              Player[]           @relation("participations")
  drawSize             Int?
  qualifiers           Int?
  levelId              String?
  level                Level?             @relation(fields: [levelId], references: [id])
  deletedAt            DateTime?
}

enum Gender {
  MALE
  FEMALE
}

enum TournamentStatus {
  PREPARATION
  IN_PROGRESS
  FINISHED
  CANCELLED
}

model Surface {
  id          String       @id @default(cuid())
  name        String
  tournaments Tournament[]
  deletedAt   DateTime?
}

model Venue {
  id          String       @id @default(cuid())
  name        String
  phone       String
  address     String
  tournaments Tournament[]
  deletedAt   DateTime?
}

model Player {
  id             String       @id @default(cuid())
  name           String
  nickname       String?
  lastname       String?
  gender         Gender
  mail           String?
  phone          String?
  photoUrl       String?
  photoThumbUrl  String?
  games          Game[]
  sets           Set[]
  tournaments    Tournament[] @relation("participations")
  winnerMatches  Match[]      @relation("Winner")
  player1Matches Match[]      @relation("Player1")
  player2Matches Match[]      @relation("Player2")
  wonTournaments Tournament[] @relation("champion") // Relación uno a muchos (torneos ganados)
  deletedAt      DateTime?
  userId         String?  @unique
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  levelId        String?
  level          Level?   @relation(fields: [levelId], references: [id])
  levelHistory   PlayerLevelHistory[]
}

// Niveles ordenados de menor a mayor (`order`); son una referencia orientativa, no una restricción.
model Level {
  id         String   @id @default(cuid())
  name       String   @unique
  order      Int
  players    Player[]
  tournaments Tournament[]
  history    PlayerLevelHistory[]
  deletedAt  DateTime?
}

model PlayerLevelHistory {
  id        String   @id @default(cuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  levelId   String?
  level     Level?   @relation(fields: [levelId], references: [id])
  reason    String?
  createdAt DateTime @default(now())

  @@index([playerId, createdAt])
}

model TournamentCategory {
  id                       String                     @id @default(cuid())
  name                     String
  tournaments              Tournament[]
  tournamentCategoryPoints TournamentCategoryPoints[]
  pointsPerMatchWin        Int                        @default(0)
  deletedAt                DateTime?
}

model TournamentType {
  id          String       @id @default(cuid())
  name        String       @unique
  tournaments Tournament[]
  deletedAt   DateTime?
}

model TournamentCategoryPoints {
  id                   String             @id @default(cuid())
  initial_position     Int
  final_position       Int
  points               Int
  tournamentCategory   TournamentCategory @relation(fields: [tournamentCategoryId], references: [id])
  tournamentCategoryId String
}

model Match {
  id           String      @id @default(cuid())
  winnerId     String
  winner       Player      @relation("Winner", fields: [winnerId], references: [id])
  tournamentId String?
  tournament   Tournament? @relation(fields: [tournamentId], references: [id])
  player1Id    String
  player1      Player      @relation("Player1", fields: [player1Id], references: [id])
  player2Id    String
  player2      Player      @relation("Player2", fields: [player2Id], references: [id])
  sets         Set[]
  stage        MatchStage?
  playedAt     DateTime?
  deletedAt    DateTime?
}

enum MatchStage {
  GROUP
  ROUND_OF_16
  QUARTERFINAL
  SEMIFINAL
  FINAL
}

model Set {
  id                    String  @id @default(cuid())
  winnerId              String
  winner                Player  @relation(fields: [winnerId], references: [id])
  matchId               String
  match                 Match?  @relation(fields: [matchId], references: [id])
  hasTiebreak           Boolean @default(false)
  tiebreakPlayer1Points Int?
  tiebreakPlayer2Points Int?
  games                 Game[]
}

model Game {
  id       String @id @default(cuid())
  winnerId String
  winner   Player @relation(fields: [winnerId], references: [id])
  setId    String
  set      Set?   @relation(fields: [setId], references: [id])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String
  role          UserRole  @default(USER)
  isActive      Boolean   @default(true)
  player        Player?
  deletedAt     DateTime?
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum UserRole {
  USER
  ADMIN
}

model AuditLog {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  actorId    String?
  actorRole  String?
  actorEmail String?
  action     String
  entity     String
  entityId   String?
  before     Json?
  after      Json?
  metadata   Json?

  @@index([createdAt])
  @@index([action])
  @@index([entity, entityId])
  @@index([actorId])
}
