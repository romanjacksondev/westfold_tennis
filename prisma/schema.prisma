// schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL") // uses connection pooling
  directUrl = env("POSTGRES_URL_NON_POOLING") // uses a direct connection
}

model Player {
  id             String       @id @default(cuid())
  name           String
  games          Game[]
  sets           Set[]
  tournaments    Tournament[]
  winnerMatches  Match[]      @relation("Winner")
  player1Matches Match[]      @relation("Player1")
  player2Matches Match[]      @relation("Player2")
}

model Tournament {
  id       String   @id @default(cuid())
  name     String
  location String?
  winnerId String
  winner   Player   @relation(fields: [winnerId], references: [id])
  points   String
  date     DateTime @default(now())
  matches  Match[]
}

model Match {
  id           String      @id @default(cuid())
  winnerId     String
  winner       Player      @relation("Winner", fields: [winnerId], references: [id])
  tournamentId String?
  tournament   Tournament? @relation(fields: [tournamentId], references: [id])
  player1Id    String
  player1      Player      @relation("Player1", fields: [player1Id], references: [id])
  player2Id    String
  player2      Player      @relation("Player2", fields: [player2Id], references: [id])
  sets         Set[]
}

model Set {
  id       String  @id @default(cuid())
  winnerId String
  winner   Player  @relation(fields: [winnerId], references: [id])
  matchId  String
  match    Match[]
}

model Game {
  id       String @id @default(cuid())
  winnerId String
  winner   Player @relation(fields: [winnerId], references: [id])
  playerId String
}
